<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.uni</groupId>
    <artifactId>cp-sat-solver-test</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>CP-SAT Stundenplan-Demo</name>
    <description>Lern- und Demo-Projekt: Ein Mini-Stundenplan mit dem Google OR-Tools CP-SAT-Solver (lokal, Java).</description>

    <properties>
        <!-- Java 21 (LTS) als Ziel: laeuft auf jedem JDK >= 21, also auch mit dem JDK 26 des Projekts. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Aktuelle OR-Tools-Version (Maven Central, Stand Januar 2026). -->
        <ortools.version>9.15.6755</ortools.version>

        <!-- Die Hauptklasse, die "mvnw exec:java" startet. -->
        <exec.mainClass>de.uni.stundenplan.StundenplanDemo</exec.mainClass>
    </properties>

    <dependencies>
        <!--
            OR-Tools fuer Java. Diese EINE Abhaengigkeit reicht aus:
            - ortools-java enthaelt die Java-API (CpModel, CpSolver, ...).
            - Transitiv kommen die plattformspezifischen JARs mit (z. B. ortools-win32-x86-64),
              in denen die native C++-Bibliothek des Solvers steckt.
            Der Solver laeuft damit komplett LOKAL auf diesem Rechner (JNI), es gibt keinen Cloud-Aufruf.
        -->
        <dependency>
            <groupId>com.google.ortools</groupId>
            <artifactId>ortools-java</artifactId>
            <version>${ortools.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <!-- Startet die Demo direkt aus Maven heraus: mvnw.cmd compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
