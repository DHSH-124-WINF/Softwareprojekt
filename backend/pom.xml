<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>de.dhsh</groupId>
    <artifactId>stundenplanung-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>stundenplanung-parent</name>
    <description>Backend (REST-API) der Stundenplanungs-Webanwendung</description>

    <!--
        Jedes Fachmodul ist in die Packages "api" und "internal" aufgeteilt.
        Andere Module dürfen nur das api-Package verwenden; geprüft wird das
        durch den ArchUnit-Test ModulgrenzenTest im Modul "application".
    -->
    <modules>
        <module>datenerfassung</module>
        <module>planerstellung</module>
        <module>planbearbeitung</module>
        <module>application</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Eigene Module, damit Versionen in den Modul-POMs entfallen -->
            <dependency>
                <groupId>de.dhsh</groupId>
                <artifactId>datenerfassung</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.dhsh</groupId>
                <artifactId>planerstellung</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.dhsh</groupId>
                <artifactId>planbearbeitung</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Testabhängigkeiten für alle Module -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Formatierung nach formatter/formatter.xml. -->
            <plugin>
                <groupId>net.revelc.code.formatter</groupId>
                <artifactId>formatter-maven-plugin</artifactId>
                <version>2.27.0</version>
                <configuration>
                    <!-- configFile wird von scripts/format-code.* per -Dconfigfile übergeben -->
                    <lineEnding>LF</lineEnding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
